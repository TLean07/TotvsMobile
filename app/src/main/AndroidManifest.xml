<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Meeting recorder: microphone capture that keeps running with the screen off. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TotvsApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.TotvsMobile">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TotvsMobile.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TotvsMobile.NoActionBar" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TotvsMobile.NoActionBar" />

        <activity
            android:name=".ui.users.UsersActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TotvsMobile.NoActionBar" />

        <activity
            android:name=".ui.insights.RiscosActivity"
            android:exported="false"
            android:theme="@style/Theme.TotvsMobile.NoActionBar" />

        <activity
            android:name=".ui.insights.OportunidadesActivity"
            android:exported="false"
            android:theme="@style/Theme.TotvsMobile.NoActionBar" />

        <activity
            android:name=".ui.alertas.AlertasActivity"
            android:exported="false"
            android:theme="@style/Theme.TotvsMobile.NoActionBar" />

        <!-- Meeting recorder -->
        <activity
            android:name=".ui.gravador.GravadorActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TotvsMobile.NoActionBar" />

        <activity
            android:name=".ui.gravador.RevisaoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TotvsMobile.NoActionBar" />

        <activity
            android:name=".ui.gravador.GravacoesActivity"
            android:exported="false"
            android:theme="@style/Theme.TotvsMobile.NoActionBar" />

        <activity
            android:name=".ui.gravador.ImportarAudioActivity"
            android:exported="false"
            android:theme="@style/Theme.TotvsMobile.NoActionBar" />

        <service
            android:name=".audio.MeetingRecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
