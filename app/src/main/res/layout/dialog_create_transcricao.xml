<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/dialogCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="name"
            android:background="@drawable/bg_input"
            android:hint="Cliente"
            android:inputType="text"
            android:minHeight="52dp"
            android:paddingHorizontal="14dp"
            android:textColor="@color/on_background_light"
            android:textColorHint="@color/text_muted_light"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/dialogVendedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:autofillHints="name"
            android:background="@drawable/bg_input"
            android:hint="Vendedor (opcional)"
            android:inputType="text"
            android:minHeight="52dp"
            android:paddingHorizontal="14dp"
            android:textColor="@color/on_background_light"
            android:textColorHint="@color/text_muted_light"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/dialogTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:autofillHints=""
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:hint="Cole aqui a transcrição da reunião…"
            android:inputType="textMultiLine"
            android:minHeight="140dp"
            android:padding="14dp"
            android:textColor="@color/on_background_light"
            android:textColorHint="@color/text_muted_light"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</ScrollView>
