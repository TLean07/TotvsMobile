<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_light"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/gravacaoIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_speaker_pill"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/totvs_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/gravacaoTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary_light"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Hospital Vida" />

            <TextView
                android:id="@+id/gravacaoMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary_light"
                android:textSize="12sp"
                tools:text="14/09 10:32 · 12:41 · 2 pessoas" />

            <TextView
                android:id="@+id/gravacaoPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_muted_light"
                android:textSize="12sp"
                tools:text="Bom dia, obrigado por reservar esse horário…" />
        </LinearLayout>

        <TextView
            android:id="@+id/gravacaoStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_warning"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/chip_warning_fg"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Rascunho" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
