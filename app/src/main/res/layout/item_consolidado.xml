<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_turn_bubble"
    android:orientation="horizontal">

    <View
        android:id="@+id/consAccent"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/totvs_danger" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/consCategoria"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Insatisfação com processos" />

            <TextView
                android:id="@+id/consBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_muted"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:textColor="@color/chip_muted_fg"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Média" />
        </LinearLayout>

        <TextView
            android:id="@+id/consMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted_light"
            android:textSize="12sp"
            tools:text="2 ocorrências internas" />

        <LinearLayout
            android:id="@+id/consEvidencias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/consRecomendacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary_light"
            android:textSize="13sp"
            tools:text="Recomendação…" />
    </LinearLayout>
</LinearLayout>
