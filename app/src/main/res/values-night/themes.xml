<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TotvsMobile" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/totvs_secondary</item>
        <item name="colorPrimaryVariant">@color/totvs_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/totvs_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/on_background_dark</item>
        <item name="colorError">@color/totvs_danger</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <item name="materialButtonStyle">@style/Widget.Totvs.Button</item>
    </style>
</resources>
