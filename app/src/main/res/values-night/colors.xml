<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark theme overrides. The layouts reference the *_light tokens directly, so
  redefining them here (when the system is in dark mode) flips every screen to a
  dark navy palette without touching a single layout. Brand colors (navy/blue
  gradients, accent green) stay the same in both modes.
-->
<resources>
    <!-- Surfaces / backgrounds → dark navy -->
    <color name="background_light">#0B1220</color>
    <color name="login_background">#0B1220</color>
    <color name="surface_light">#111B2E</color>
    <color name="surface_muted_light">#1B2942</color>

    <!-- Text -->
    <color name="on_background_light">#E2E8F0</color>
    <color name="text_primary_light">#F1F5F9</color>
    <color name="text_secondary_light">#A8B6CC</color>
    <color name="text_muted_light">#7184A0</color>

    <!-- Borders / inputs -->
    <color name="border_light">#243353</color>
    <color name="input_bg_light">#0F1A2E</color>

    <!-- Status / banners that need a dark backdrop -->
    <color name="totvs_danger_bg">#3A1620</color>

    <!-- Component tokens -->
    <color name="button_primary">#2B6CB0</color>
    <color name="chart_track">#1B2942</color>
    <color name="chart_value">#F1F5F9</color>
    <color name="chart_label">#A8B6CC</color>

    <!-- Login card: lighter than the page so it pops on the dark gradient -->
    <color name="login_card">#16243C</color>
    <color name="login_card_stroke">#2A3A57</color>

    <!-- Outlined secondary action button → white text/icon in dark -->
    <color name="action_fg">#FFFFFF</color>
    <color name="action_stroke">#33FFFFFF</color>

    <!-- Adaptive chips -->
    <color name="chip_role_bg">#1C2B46</color>
    <color name="chip_role_fg">#8FBCEC</color>
    <color name="chip_success_bg">#15291F</color>
    <color name="chip_success_fg">#34D399</color>
    <color name="chip_muted_bg">#1B2942</color>
    <color name="chip_muted_fg">#9AA9C0</color>
</resources>
