<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TotvsMobile" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/totvs_primary</item>
        <item name="colorPrimaryVariant">@color/totvs_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/totvs_secondary</item>
        <item name="colorSecondaryVariant">@color/totvs_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/on_background_light</item>
        <item name="colorError">@color/totvs_danger</item>

        <!-- Edge-to-edge: transparent system bars, insets handled by SafeAreaHelper -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Top of every screen is the navy brand gradient → white status icons. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <item name="materialButtonStyle">@style/Widget.Totvs.Button</item>
    </style>

    <style name="Theme.TotvsMobile.NoActionBar" />

    <!-- Splash (androidx core-splashscreen) -->
    <style name="Theme.TotvsMobile.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/totvs_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_anim</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/totvs_primary</item>
        <item name="postSplashScreenTheme">@style/Theme.TotvsMobile.NoActionBar</item>
    </style>

    <!-- Components -->
    <style name="Widget.Totvs.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/button_primary</item>
    </style>

    <style name="Widget.Totvs.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface_light</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="Text.Totvs.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Totvs.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_secondary_light</item>
    </style>

    <!-- Bottom sheet (transparent window so the rounded-top content shows) -->
    <style name="Theme.Totvs.BottomSheet" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Totvs.BottomSheet.Modal</item>
    </style>

    <style name="Totvs.BottomSheet.Modal" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.Totvs.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/totvs_secondary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/totvs_secondary</item>
        <item name="android:textColorHint">@color/text_muted_light</item>
        <item name="startIconTint">@color/totvs_secondary</item>
        <item name="endIconTint">@color/text_muted_light</item>
        <item name="boxBackgroundColor">@color/input_bg_light</item>
    </style>
</resources>
