<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay: lets the recorder screens be launched from adb
  (`am start -n com.tlean07.totvs/.ui.gravador.GravadorActivity`) for UI
  testing on an emulator without going through the login flow. Release builds
  keep every activity private.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name=".ui.gravador.GravadorActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <activity
            android:name=".ui.gravador.GravacoesActivity"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
